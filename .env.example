# Copy to .env and adjust as needed: cp .env.example .env

# HTTP port for the API, Swagger and dashboard
WAHA_HTTP_PORT=3000

# Auth (dashboard connects with the API key; keep them in sync)
WAHA_API_KEY=admin
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=admin
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=admin

# WebRTC media for native calls.
# Fixed UDP port funnels all browser media through a single, published port.
WEBRTC_UDP_PORT=7881
# Host/IP the browser uses to reach this server. Leave empty for localhost.
# Set it to your LAN/public IP (or the 1:1 NAT address) for remote access.
# Note: browser microphone access requires HTTPS on non-localhost hosts.
WAHA_PUBLIC_IP=
